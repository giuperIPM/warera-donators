[Unit]
Description=WarEra weekly Italy rankings
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=warera
WorkingDirectory=/opt/warera-rankings
EnvironmentFile=/opt/warera-rankings/.env
ExecStart=/opt/warera-rankings/.venv/bin/python -m warera_rankings --output-dir /opt/warera-rankings/data
